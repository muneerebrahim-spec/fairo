{
  "expo": {
    "name": "Fairo",
    "slug": "fairo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fairo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Fairo needs camera access to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Fairo needs photo library access to import receipt images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Fairo needs photo library access to import receipt images.",
          "cameraPermission": "Fairo needs camera access to scan receipts."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
